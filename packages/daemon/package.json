{
  "name": "@agentic/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "AGENTIC_ENV=dev bun run src/index.ts",
    "test-client": "bun run scripts/test-client.ts",
    "memory-smoke": "bun run scripts/memory-smoke.ts",
    "keychain-set": "bun run scripts/keychain-set.ts",
    "keychain-prod-probe": "bun run scripts/keychain-prod-probe.ts",
    "smart-distiller-probe": "bun run scripts/smart-distiller-probe.ts",
    "migrate-distiller-v2": "bun run scripts/migrate-distiller-v2.ts",
    "backfill-embeddings": "AGENTIC_EMBED_AUTODOWNLOAD=1 bun run scripts/backfill-embeddings.ts",
    "memory-demo-harness": "bun run scripts/memory-demo-harness.ts",
    "embed-probe": "AGENTIC_EMBED_AUTODOWNLOAD=1 bun run scripts/embed-probe.ts",
    "fts5-check": "bun run scripts/fts5-unicode61-check.ts",
    "retrieval-golden-eval": "EMBEDDING_PROVIDER=local-wasm AGENTIC_EMBED_AUTODOWNLOAD=1 bun run scripts/retrieval-golden-eval.ts",
    "memory-search-probe": "LLM_PROVIDER=anthropic-api bun run scripts/memory-search-probe.ts"
  },
  "dependencies": {
    "@agentic/protocol": "workspace:*",
    "@anthropic-ai/sdk": "^0.100.1",
    "@lenml/tokenizers": "3.7.2",
    "onnxruntime-web": "1.27.0",
    "zod": "^3.23.0"
  }
}
